{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "rootDir": ".", "outDir": "dist", "strict": true, "skipLibCheck": true,
    "esModuleInterop": true, "forceConsistentCasingInFileNames": true,
    "declaration": true, "sourceMap": true
  },
  "include": ["src/**/*.ts", "cli/**/*.ts", "web/**/*.ts"]
}
