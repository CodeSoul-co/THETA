THETA_AGENT_SERVICE_MODE=local
THETA_AGENT_HTTP_PORT=8088
THETA_AGENT_ALLOWED_ORIGINS=http://localhost:8088
THETA_AGENT_TRUSTED_HOSTS=localhost,127.0.0.1

# Set deployed only when the existing Business API is reachable and its
# browser session/CSRF contract is enabled.
# THETA_AGENT_SERVICE_MODE=deployed
# THETA_BUSINESS_API_URL=http://business-api:8080
# THETA_AGENT_ALLOWED_ORIGINS=https://theta.example.com
# THETA_AGENT_TRUSTED_HOSTS=theta.example.com

# Conversational model; keep the key in the host environment or Docker secret.
# THETA_INFERENCE_PROVIDER=openai-compatible
# THETA_INFERENCE_API_KEY=
# THETA_INFERENCE_BASE_URL=https://provider.example/v1
# THETA_INFERENCE_MODEL=model-name

# Hosted Worker model/runtime mapping. Never bake this file into the image.
THETA_BUSINESS_BINDINGS_HOST=./empty-bindings.json
THETA_BUSINESS_BINDINGS=/run/secrets/business-bindings.json
