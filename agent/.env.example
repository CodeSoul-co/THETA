# Process environment > agent/.env.local > agent/.env > repository .env.local/.env
THETA_INFERENCE_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
# OPENAI_API_KEY=
# OPENAI_MODEL=
# MINIMAX_API_KEY=
# GLM_API_KEY=
# Generic Chat Completions profile: configure these three together.
# THETA_INFERENCE_API_KEY=
# THETA_INFERENCE_BASE_URL=
# THETA_INFERENCE_MODEL=

# Local is default; configure a Python environment with the engine's dependencies.
# Automatically prefers agent/.venv when present, otherwise python3.
# THETA_PYTHON=/absolute/path/to/python
# Optional worker environments. Unset = shared compatibility environment above.
# Configured paths must exist; workers never silently fall back or install packages.
# THETA_WORKER_CLASSIC_PYTHON=/absolute/path/to/classic/bin/python
# THETA_WORKER_NEURAL_PYTHON=/absolute/path/to/neural/bin/python
# THETA_WORKER_REPORTS_PYTHON=/absolute/path/to/reports/bin/python
# Statistics defaults to agent/.local/runtimes/statistics/bin/python (no shared fallback).
# Create this isolated environment using docs/free-analysis.md.
# THETA_WORKER_STATISTICS_PYTHON=/absolute/path/to/statistics/bin/python
# THETA_WORKER_STATISTICS_REVISION=v1
# Deployment revision (use the same revision for the corresponding cloud image).
# THETA_WORKER_CLASSIC_REVISION=v1
# THETA_WORKER_NEURAL_REVISION=v1
# THETA_WORKER_REPORTS_REVISION=v1
# THETA_AGENT_HOME=/absolute/path/to/session-and-artifact-storage
# THETA_PROJECT_ROOT=/absolute/path/to/repository
# Local is the default and binds to 127.0.0.1. The deployable service binds to
# 0.0.0.0 only when all authentication boundaries below are configured.
# THETA_AGENT_SERVICE_MODE=deployed
# THETA_AGENT_API_HOST=0.0.0.0
# THETA_AGENT_API_PORT=4318
# THETA_AGENT_ALLOWED_ORIGINS=https://theta.example.com
# THETA_AGENT_TRUSTED_HOSTS=theta.example.com
# QWEN_MODEL_0_6B=/absolute/path/to/cached/qwen
# SBERT_MODEL_PATH=/absolute/path/to/models/sbert/paraphrase-multilingual-MiniLM-L12-v2
# THETA zero_shot can use a configured cloud provider; each training still needs confirmation.
# EMBEDDING_PROVIDER=cloud
# EMBEDDING_CLOUD_PROVIDER=zhipu
# EMBEDDING_MODEL=embedding-3
# EMBEDDING_API_KEY=

# Optional existing Go control plane (host-managed dataset/model registration required).
# THETA_COMPUTE_URL=http://127.0.0.1:8080
# THETA_COMPUTE_TOKEN=
# THETA_COMPUTE_BINDINGS=/absolute/path/to/private-bindings.json

# Optional public Business API (https://theta.code-soul.com). Setting the URL switches
# training to the hosted service; the Node process holds the session cookie and CSRF
# token in memory only. Credentials stay in this private file and are never sent to the model.
# The account needs an existing project or explicit permission to create one, plus the
# deployment's own model_id/runtime_id values: there is no model list API to guess from.
# THETA_BUSINESS_API_URL=https://theta.code-soul.com
# THETA_BUSINESS_IDENTIFIER=
# THETA_BUSINESS_PASSWORD=
# THETA_BUSINESS_BINDINGS=/absolute/path/to/private-business-bindings.json
#   {
#     "projectId": "project UUID, or omit and set projectTitle",
#     "projectTitle": "THETA Agent",
#     "allowProjectCreate": false,
#     "models": { "lda": { "modelId": 1, "runtimeId": 1 } },
#     "datasets": { "<local datasetRef>": { "datasetRef": "registered ref", "sha256": "<hash>" } }
#   }
