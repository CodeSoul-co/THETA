# Worker identity and routing. A CPU Worker reads only the CPU stream; a GPU
# Worker reads only the GPU stream.
WORKER_ID=worker-local-cpu-01
WORKER_RESOURCE_CLASS=cpu
WORKER_GPU_ID=
WORKER_SUPPORTED_RUNTIME_IDS=
WORKER_SUPPORTED_MODELS=theta,lda,hdp,stm,btm,etm,ctm,dtm,nvdm,gsm,prodlda,bertopic

# Parent THETA repository and disposable per-task workspace.
THETA_PROJECT_ROOT=D:/codesoul/projects/THETA
WORKER_JOB_ROOT=D:/theta-worker/jobs
WORKER_PYTHON_EXECUTABLE=python
WORKER_KEEP_JOB_DIR=true
WORKER_HEARTBEAT_INTERVAL_SECONDS=15
WORKER_SHUTDOWN_GRACE_SECONDS=15

# Same Redis instance and stream names as the Go control plane.
REDIS_ADDR=127.0.0.1:6379
REDIS_USERNAME=
# Leave blank for a Redis server without authentication. The provided
# docker-compose.yml uses redis_dev_password.
REDIS_PASSWORD=
REDIS_DB=0
REDIS_STREAM_CPU_JOBS=theta:jobs:cpu
REDIS_STREAM_GPU_JOBS=theta:jobs:gpu
REDIS_STREAM_JOB_EVENTS=theta:jobs:events
REDIS_STREAM_DEAD_LETTER=theta:jobs:dead-letter
REDIS_WORKER_CONSUMER_GROUP=
REDIS_WORKER_CONSUMER_NAME=
REDIS_WORKER_BLOCK_MS=5000
REDIS_WORKER_BATCH_SIZE=1
REDIS_WORKER_CLAIM_IDLE_MS=60000
REDIS_STREAM_MAX_LENGTH=100000
REDIS_CANCEL_KEY_PREFIX=theta:job-cancel:
REDIS_JOB_LOCK_KEY_PREFIX=theta:job-lock:
REDIS_JOB_DONE_KEY_PREFIX=theta:job-done:
REDIS_JOB_LOCK_TTL_SECONDS=60
REDIS_JOB_DONE_TTL_SECONDS=604800

# Local development: object keys map to files below this directory. Put input
# datasets here using the object_key stored in MySQL.
OBJECT_STORAGE_DRIVER=filesystem
OBJECT_STORAGE_FILESYSTEM_ROOT=D:/theta-object-storage

# S3/MinIO alternative. Set OBJECT_STORAGE_DRIVER=s3 to use these values.
OBJECT_STORAGE_ENDPOINT=127.0.0.1:9000
OBJECT_STORAGE_BUCKET=training-artifacts
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_SESSION_TOKEN=
OBJECT_STORAGE_USE_SSL=false
